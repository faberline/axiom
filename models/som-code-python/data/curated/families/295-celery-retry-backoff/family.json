{
  "family_id": "295-celery-retry-backoff",
  "domain": "python",
  "area": "celery",
  "capability": "celery-retry-backoff",
  "requirement": "Deliver webhooks from a Celery task that retries transient failures with capped exponential backoff and jitter but fails fast on permanent errors.",
  "skeleton": "TransientError and PermanentError, a backoff helper with full jitter, and a bound deliver task using self.retry with max_retries and acks_late.",
  "caption": "A Celery webhook delivery task using celery Celery and Task, random and collections.abc, with an eager in-memory app. backoff raises ValueError for negative retries and returns a full-jitter delay between zero and a ceiling that doubles from 2 seconds and is capped at 60. deliver is a bound task with max_retries 4 and acks_late that calls send_webhook, retries only TransientError through self.retry with the backoff countdown, lets PermanentError fail immediately, and re-raises the TransientError once retries are exhausted. The fixture asserts retry until success, the retry limit, no retry for PermanentError, the capped backoff and the task options.",
  "plan": {
    "intent": "Retry flaky webhook deliveries",
    "target": "Celery retry with backoff",
    "constraints": [
      "Only TransientError is retried",
      "At most 4 retries are attempted",
      "The delay ceiling doubles from 2 seconds and is capped at 60",
      "The delay is drawn uniformly between 0 and the ceiling",
      "Negative retry counts raise ValueError"
    ]
  },
  "rationale": {
    "teaches": "Classify errors, call self.retry with a jittered countdown from request.retries, and bound retries explicitly.",
    "why": "Retrying every exception with unbounded, jitter-free delays hammers failing endpoints and hides permanent errors."
  },
