# syntax=docker/dockerfile:1

# Build both source candidates together only when neither immutable image was
# supplied.  The one-service candidate Dockerfiles live beside this file: the
# classic Cloud Build Docker daemon evaluates preceding stages even with
# --target, so a separate Dockerfile is the only reliable pruning boundary.
FROM rust:1.96-bookworm AS service-builder
ARG SOURCE_REVISION
WORKDIR /workspace
COPY . .
# `delegated-auth` carries lumen's TokenReview/SubjectAccessReview transport.
# `spec.auth` defaults to `required`, and a binary built without it refuses to
# start rather than serve unauthenticated -- so omitting it here crash-loops
# every auth-mode instance the run deploys. This is the default build path:
# both images at once, taken whenever neither was supplied by digest.
RUN test -n "${SOURCE_REVISION}" \
 && bash acceptance/gcp/scripts/faberline-source.sh lumen /src/lumen \
 && cargo build --locked --release --manifest-path /src/lumen/Cargo.toml -p lumen --bin lumen \
      --features "otel operator raft-wal jieba delegated-auth" \
 && SIFT_SOURCE_REVISION="${SOURCE_REVISION}" cargo build --locked --release -p sift --bin sift \
 && install -D -m 0755 /src/lumen/target/release/lumen /out/lumen \
 && install -D -m 0755 target/release/sift /out/sift

FROM gcr.io/distroless/cc-debian12:nonroot AS lumen
COPY --from=service-builder /out/lumen /usr/local/bin/lumen
EXPOSE 7373
ENTRYPOINT ["/usr/local/bin/lumen"]
CMD ["serve"]

FROM gcr.io/distroless/cc-debian12:nonroot AS sift
COPY --from=service-builder /out/sift /usr/local/bin/sift
ENV SIFT_HOST=0.0.0.0 \
    SIFT_PORT=7380 \
    SIFT_DATA_DIR=/var/lib/sift \
    SIFT_LOG_FORMAT=json
VOLUME ["/var/lib/sift"]
EXPOSE 7380
ENTRYPOINT ["/usr/local/bin/sift"]
CMD ["serve"]
